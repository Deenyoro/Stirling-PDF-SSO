           set -eu
 
+          # SSO fork override: this repo has no access to the depot.dev runner
+          # pool that upstream Stirling-Tools/Stirling-PDF uses for "trusted"
+          # runs. Force is_fork=true on any non-upstream repo so downstream
+          # jobs pick ubuntu-latest instead of queueing forever on a runner
+          # that will never appear.
+          if [ "${GITHUB_REPOSITORY}" != "Stirling-Tools/Stirling-PDF" ]; then
+            echo "is_fork=true" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
