# Stirling-PDF-SSO deployment settings for sso/deploy/docker-compose.yml.
# Copy to .env and edit:  cp sso/deploy/.env.example sso/deploy/.env

# Image to run (defaults to ghcr.io/deenyoro/stirling-pdf-sso:latest).
# STIRLING_PDF_SSO_IMAGE=ghcr.io/deenyoro/stirling-pdf-sso:latest

# Host port.
STIRLING_PORT=8080

# First-boot local admin. REQUIRED: there is no default password and compose
# will not start without one. Generate with: openssl rand -base64 24
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# OIDC client secret, if you enable the SECURITY_OAUTH2_* block.
# OAUTH2_CLIENT_SECRET=
